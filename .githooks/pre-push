#!/usr/bin/env bash
# Full gate. Skipping this hook is forbidden.
# Do not create a temporary repository here. A caller that does must unset
# GIT_DIR and GIT_INDEX_FILE first, or the new repository lands in this one.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
if [[ -n "$(git config --get gpg.ssh.allowedSignersFile || true)" ]]; then
	export HYGIENE_SIGNATURE=verified
fi
exec make check
